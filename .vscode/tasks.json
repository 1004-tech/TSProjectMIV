{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Webpack Dev Server",
      "type": "shell",
      "command": "npx kill-port 3001 ; npx webpack serve --config client/webpack.config.js --mode development",
      "isBackground": true,
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^ERROR in (.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[webpack-dev-server\\] Project is running at",
          "endsPattern": "compiled successfully"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Stop Webpack Dev Server",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "npx kill-port 3001",
      ],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    },
  ]
}