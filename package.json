{
  "name": "project_name",
  "version": "1.0.0",
  "description": "project_description",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "webpack --config client/webpack.config.js --mode production",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only --project server/tsconfig.json server/src/index.ts",
    "dev:client": "webpack serve --config client/webpack.config.js --mode development",
    "clean": "rimraf server/dist client/dist",
    "lint": "eslint \"{client,server}/src/**/*.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "concurrently": "^10.0.3",
    "css-loader": "^7.1.4",
    "eslint": "^10.5.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.8.1",
    "rimraf": "^6.1.3",
    "kill-port": "^2.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5",
    "copy-webpack-plugin": "^12.0.2",
    "@1oo4/miv": "^1.0.0"
  },
  "dependencies": {
    "@1oo4/miv": "^1.0.0",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "mini-css-extract-plugin": "^2.10.2"
  }
}